# Copia este archivo a .env.local y llena los valores.
# Todo lo que empieza con VITE_ se ve en el navegador: usa solo la llave PÚBLICA.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Cada cuántos segundos manda lecturas el ESP32 (5 en la demo, 60 en producción).
VITE_READING_INTERVAL_S=5
